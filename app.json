{
  "expo": {
    "name": "Lockin Club",
    "slug": "lockin_app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "lockinapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.lockin.club",
      "appleTeamId": "CCQU7Z66V5",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:lockin.club"],
      "icon": "./assets/images/logo.jpg",
      "infoPlist": {
        "NSCameraUsageDescription": "Required for timelapse recording",
        "NSPhotoLibraryAddUsageDescription": "Save timelapse videos to your gallery",
        "NSPhotoLibraryUsageDescription": "Access your photos to save timelapse videos",
        "NSFamilyControlsUsageDescription": "LockIn uses Screen Time to help you manage app usage and build better habits",
        "NSMotionUsageDescription": "Used to detect device orientation for timer display",
        "NSLocationWhenInUseUsageDescription": "This app does not use your location",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lockin.club",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for timelapse recording"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.jpg",
          "color": "#000000"
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "CCQU7Z66V5",
          "appGroup": "group.com.lockin.club"
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to track your focus sessions",
          "enableFrameProcessors": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6382fb0a-413b-4204-8b4d-62c83d6dd462"
      }
    }
  }
}
