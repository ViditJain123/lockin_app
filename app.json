{
  "expo": {
    "name": "lockin_app",
    "slug": "lockin_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lockinapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.lockinwithvidit.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Required for timelapse recording",
        "NSPhotoLibraryAddUsageDescription": "Save timelapse videos to your gallery",
        "NSPhotoLibraryUsageDescription": "Access your photos to save timelapse videos",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for timelapse recording"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
