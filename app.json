{
  "expo": {
    "name": "Lockin Club",
    "slug": "lockin_app",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "lockinapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.lockin.club",
      "appleTeamId": "CCQU7Z66V5",
      "buildNumber": "4",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:lockin.club"
      ],
      "icon": "./assets/images/logo.jpg",
      "infoPlist": {
        "NSCameraUsageDescription": "Required for timelapse recording and to capture a photo at the end of your grind",
        "NSPhotoLibraryAddUsageDescription": "Save your grind timelapses and photo cards to your gallery",
        "NSPhotoLibraryUsageDescription": "Access your photos to save grind timelapses and photo cards",
        "NSFamilyControlsUsageDescription": "LockIn uses Screen Time to help you manage app usage and build better habits",
        "NSMotionUsageDescription": "Used to detect device orientation for timer display",
        "NSLocationWhenInUseUsageDescription": "This app does not use your location",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.jpg",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lockin.club",
      "versionCode": 10,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lockin.club",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/quicksand/300Light/Quicksand_300Light.ttf",
            "./node_modules/@expo-google-fonts/quicksand/400Regular/Quicksand_400Regular.ttf",
            "./node_modules/@expo-google-fonts/quicksand/500Medium/Quicksand_500Medium.ttf",
            "./node_modules/@expo-google-fonts/quicksand/600SemiBold/Quicksand_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/quicksand/700Bold/Quicksand_700Bold.ttf",
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
            "./node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/bebas-neue/400Regular/BebasNeue_400Regular.ttf",
            "./node_modules/@expo-google-fonts/jetbrains-mono/400Regular/JetBrainsMono_400Regular.ttf",
            "./node_modules/@expo-google-fonts/jetbrains-mono/500Medium/JetBrainsMono_500Medium.ttf",
            "./node_modules/@expo-google-fonts/jetbrains-mono/600SemiBold/JetBrainsMono_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/jetbrains-mono/700Bold/JetBrainsMono_700Bold.ttf",
            "./assets/fonts/SpaceMono-Regular.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for timelapse recording"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.jpg",
          "color": "#000000"
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "CCQU7Z66V5",
          "appGroup": "group.com.lockin.club"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6382fb0a-413b-4204-8b4d-62c83d6dd462"
      }
    }
  }
}
