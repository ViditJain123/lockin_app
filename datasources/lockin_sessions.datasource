SCHEMA >
    `session_id` String `json:$.session_id`,
    `user_id` String `json:$.user_id`,
    `date` String `json:$.date`,
    `time_started` DateTime `json:$.time_started`,
    `time_ended` DateTime `json:$.time_ended`,
    `distraction_count` UInt32 `json:$.distraction_count`,
    `total_locked_in_seconds` UInt32 `json:$.total_locked_in_seconds`,
    `total_distracted_seconds` UInt32 `json:$.total_distracted_seconds`,
    `timestamp` DateTime `json:$.timestamp`

ENGINE "MergeTree"
ENGINE_SORTING_KEY "user_id, timestamp"
